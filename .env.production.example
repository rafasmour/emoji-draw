# Production environment. Written to .env on the server by
# .github/workflows/deploy-vps.yml from repository secrets.

DOMAIN=example.com
APP_NAME="Emoji Draw"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://emoji-draw.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mongodb
DB_DATABASE=emoji_draw
DB_USERNAME=emoji_draw
DB_PASSWORD=
DB_ROOT_USERNAME=root
DB_ROOT_PASSWORD=
DB_ROOT_DATABASE=admin
# Must match the values above; authenticates against the app database.
DB_URI=mongodb://emoji_draw:<DB_PASSWORD>@mongodb:27017/emoji_draw?authSource=emoji_draw

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=mongodb
QUEUE_CONNECTION=mongodb
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Public side (browser) goes through Traefik over TLS.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=emoji-draw.example.com
REVERB_PORT=443
REVERB_SCHEME=https
# Laravel broadcasts to Reverb over the private network.
REVERB_INTERNAL_HOST=reverb
REVERB_INTERNAL_PORT=8080
REVERB_INTERNAL_SCHEME=http
